<!DOCTYPE html>
<html>
<head>
  <title>Generate Table</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
    }
    #result {
      margin-top: 20px;
      font-size: 20px;
      line-height: 28px;
    }
  </style>
</head>
<body>

<h1>Generate Table</h1>

<label>Enter Number: </label>
<input type="number" id="num" placeholder="Enter number">
<button onclick="generateTable()">Generate</button>

<p id="result">Please enter a number!</p>

<script>
function generateTable() {
  let n = document.getElementById("num").value;
  let output = "";

  if (n === "") {
    document.getElementById("result").innerHTML = "Please enter a number!";
    return;
  }

  for (let i = 1; i <= 10; i++) {
    output += n + " x " + i + " = " + (n * i) + "<br>";
  }

  document.getElementById("result").innerHTML = output;
}
</script>

</body>
</html>
